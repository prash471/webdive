{
  "manifest_version": 3,
  "name": "WebDive Journey Analyzer",
  "version": "0.5.0",
  "description": "Record a web journey and analyze resources, code coverage, CPU, and long tasks locally in DevTools.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["debugger"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "devtools_page": "devtools.html",
  "minimum_chrome_version": "118"
}
